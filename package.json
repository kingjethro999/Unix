{
  "name": "unix",
  "version": "1.0.1",
  "private": true,
  "packageManager": "vlt@1.0.10",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,live \"next dev\" \"node --env-file=.env scripts/realtime-server.mjs\"",
    "dev:web": "next dev",
    "realtime": "node --env-file=.env scripts/realtime-server.mjs",
    "build": "next build",
    "desktop:dev": "concurrently --kill-others-on-fail -n web,live,desktop \"next dev\" \"node --env-file=.env scripts/realtime-server.mjs\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:build": "vlt run desktop:build:linux",
    "desktop:build:linux": "vlt run build && vlt run desktop:prepare && electron-builder --linux AppImage deb",
    "desktop:build:windows": "vlt run build && vlt run desktop:prepare && electron-builder --win nsis",
    "desktop:build:mac": "vlt run build && vlt run desktop:prepare && electron-builder --mac dmg zip",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --test test/*.test.ts",
    "test:e2e": "playwright test"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.unix.writer",
    "productName": "Unix",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server"
      },
      {
        "from": "public/images/unix-logo.png",
        "to": "unix-logo.png"
      },
      {
        "from": "desktop/runtime.json",
        "to": "runtime.json"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "desktop/icons/icon.png",
      "artifactName": "Unix-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icons/icon.ico",
      "artifactName": "Unix-Setup-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "desktop/icons/icon.icns",
      "artifactName": "Unix-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-router": "^1.158.1",
    "@tanstack/react-start": "^1.158.1",
    "@tiptap/core": "^3.17.1",
    "@tiptap/extension-bubble-menu": "3.17.1",
    "@tiptap/extension-font-family": "^3.31.3",
    "@tiptap/extension-image": "3.17.1",
    "@tiptap/extension-link": "^3.17.1",
    "@tiptap/extension-placeholder": "^3.17.1",
    "@tiptap/extension-table": "^3.17.1",
    "@tiptap/extension-text-style": "^3.17.1",
    "@tiptap/pm": "^3.17.1",
    "@tiptap/react": "^3.17.1",
    "@tiptap/starter-kit": "^3.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "debounce": "^3.0.0",
    "diff": "^8.0.3",
    "docx": "^9.5.1",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.2",
    "framer-motion": "^12.33.0",
    "input-otp": "^1.4.2",
    "isomorphic-dompurify": "^2.35.0",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.563.0",
    "marked": "^17.0.1",
    "motion": "^12.29.2",
    "next": "16.1.4",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^7.0.12",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.0",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^5.1.4",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.6",
    "@types/diff": "^8.0.0",
    "@types/node": "22.10.2",
    "@types/nodemailer": "^7.0.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.1.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jiti": "^2.6.1",
    "jsdom": "^26.1.0",
    "less": "^4.9.1",
    "lightningcss": "^1.30.2",
    "prettier": "^3.8.1",
    "sass": "^1.104.1",
    "sass-embedded": "^1.104.1",
    "stylus": "^0.64.0",
    "sugarss": "^5.0.1",
    "terser": "^5.51.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0",
    "web-vitals": "^4.2.4",
    "yaml": "^2.9.1"
  }
}
